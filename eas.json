{
  "cli": {
    "version": ">= 14.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "monthly": {
      "extends": "production",
      "environment": "production",
      "node": "22.14.0",
      "corepack": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {},
    "monthly": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
